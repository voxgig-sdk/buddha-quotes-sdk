                type: "`$STRING`"
              }
            ]
          }
          contract: {
            id: "GET /random"
            json: "{\"operationId\":\"getRandomQuote\",\"parameters\":[{\"description\":\"Filter quotes by author\",\"in\":\"query\",\"name\":\"author\",\"required\":false,\"schema\":{\"enum\":[\"Buddha\",\"Dalai Lama\",\"Dogen\",\"Thich Nhat Hanh\"],\"type\":\"string\"}}],\"protocol\":\"http\",\"responses\":{\"200\":{\"content\":{\"application/json\":{\"examples\":{\"buddha\":{\"value\":{\"author\":\"Buddha\",\"quote\":\"Whatever precious jewel there is in the heavenly worlds, there is nothing comparable to one who is Awakened.\"}},\"dogen\":{\"value\":{\"author\":\"Dogen\",\"quote\":\"But do not ask me where I am going, As I travel in this limitless world, Where every step I take is my home.\"}},\"thich\":{\"value\":{\"author\":\"Thich Nhat Hanh\",\"quote\":\"Life is available only in the present moment.\"}}},\"schema\":{\"properties\":{\"author\":{\"description\":\"The author of the quote\",\"enum\":[\"Buddha\",\"Dalai Lama\",\"Dogen\",\"Thich Nhat Hanh\"],\"type\":\"string\"},\"quote\":{\"description\":\"The text of the inspirational quote\",\"type\":\"string\"}},\"required\":[\"quote\",\"author\"],\"type\":\"object\"}}},\"description\":\"Successful response with a random quote\"},\"500\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"error\":{\"description\":\"Error message\",\"type\":\"string\"},\"message\":{\"description\":\"Detailed error description\",\"type\":\"string\"}},\"type\":\"object\"}}},\"description\":\"Internal server error\"}},\"securitySource\":\"unspecified\"}"
            source: "openapi3"
            version: 1
          }
          method: "GET"
          orig: "/random"
          segments: [
